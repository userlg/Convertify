# Convertify Configuration - EXTREME SPEED MODE

# Conversion Directories (comma-separated)
# Leave empty to use current directory
CONVERSION_DIRECTORIES=.

# Video Conversion Settings - EXTREME SPEED PROFILE
# Optimized for absolute maximum speed (3-5 seconds per 30-sec video)
VIDEO_CODEC=libx264
AUDIO_CODEC=copy
PRESET=ultrafast
CRF=30
AUDIO_BITRATE=96k
THREADS=0

# Behavior Settings
REMOVE_SOURCE=true
SKIP_IF_EXISTS=true
MAX_RETRIES=3
RETRY_DELAY_SECONDS=1.0

# Performance Settings
MAX_WORKERS=4

# Logging Settings
LOG_LEVEL=INFO
LOG_FILE=logs/convertify.log
LOG_ROTATION=10 MB
LOG_RETENTION=1 week
